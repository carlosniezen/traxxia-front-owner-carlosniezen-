# --- Supabase ---------------------------------------------------------------
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Settings → API → service_role (NEVER expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (Drizzle) -----------------------------------------------------
# Settings → Database → Connection string → "Transaction" pooler for the app,
# and the direct connection for migrations. Use the direct URL for db:migrate.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- App --------------------------------------------------------------------
# Where magic-link emails should redirect back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
